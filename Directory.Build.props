<Project>
  <PropertyGroup>
    <!-- ScreenRecorderLib 原生组件要求显式平台(targets 校验 $(Platform))。
         直接 build 单个 csproj 时 Platform 可能是空串,所以两个条件都要覆盖。 -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
</Project>
