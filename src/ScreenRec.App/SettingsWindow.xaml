<Window x:Class="ScreenRec.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenRec.App"
        Title="ScreenRec 设置" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        MouseLeftButtonDown="OnDrag">
    <Border Background="{DynamicResource Skin.Bg}" CornerRadius="12"
            BorderBrush="{DynamicResource Skin.Border}" BorderThickness="1">
        <StackPanel Margin="18,14,18,16">
            <Grid>
                <TextBlock Text="设置" Foreground="{DynamicResource Skin.Text}" FontSize="15"
                           FontWeight="SemiBold"/>
                <Button Style="{StaticResource GhostButton}" Content="✕" Width="28" Padding="0"
                        HorizontalAlignment="Right" Click="OnClose"/>
            </Grid>

            <ScrollViewer MaxHeight="520" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="外观" Foreground="{DynamicResource Skin.Accent}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,4,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主题" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbSkin" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                                  SelectionChanged="OnSkinChanged"/>
                    </Grid>

                    <TextBlock Text="视频" Foreground="{DynamicResource Skin.Accent}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="帧率" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbFrameRate" Grid.Column="1" Width="180" HorizontalAlignment="Left"/>
                        <TextBlock Text="画质" Grid.Row="1" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox x:Name="CmbQuality" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="编码器" Grid.Row="2" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox x:Name="CmbEncoder" Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="定时切段" Grid.Row="3" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox x:Name="CmbSegment" Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0"
                                  ToolTip="每段时间到点后自动落盘并新开一段:崩溃/断电最多丢最后一段。切段瞬间约损失 0.3~0.5 秒画面"/>
                    </Grid>
                    <TextBlock Text="分辨率跟随录制源(主屏原生或窗口/选区尺寸),画质档位只决定码率"
                               Foreground="{DynamicResource Skin.Muted}" FontSize="11"
                               Margin="110,6,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="音频" Foreground="{DynamicResource Skin.Accent}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="录音模式" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbAudioMode" Grid.Column="1" Width="220" HorizontalAlignment="Left"/>
                        <TextBlock Text="系统声音量" Grid.Row="1" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Slider x:Name="SldSystemVol" Width="180" Minimum="0" Maximum="1"
                                    IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="LblSystemVol" Width="42" Foreground="{DynamicResource Skin.Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="麦克风音量" Grid.Row="2" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Slider x:Name="SldMicVol" Width="180" Minimum="0" Maximum="1"
                                    IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="LblMicVol" Width="42" Foreground="{DynamicResource Skin.Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="音量在编码前按音源缩放;设备缺失时会自动降级为可用音源"
                               Foreground="{DynamicResource Skin.Muted}" FontSize="11"
                               Margin="110,6,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="鼠标" Foreground="{DynamicResource Skin.Accent}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <CheckBox x:Name="ChkPointer" Content="录制鼠标指针"
                              Foreground="{DynamicResource Skin.Text}"/>
                    <CheckBox x:Name="ChkHighlight" Content="指针高亮(给指针盖一个实心圆,只在成片里出现)"
                              Foreground="{DynamicResource Skin.Text}" Margin="0,8,0,0"
                              Checked="OnHighlightToggled" Unchecked="OnHighlightToggled"/>
                    <Grid x:Name="HighlightDetail" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="圆颜色" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center"/>
                        <local:ColorPalette x:Name="PalHighlight" Grid.Column="1"/>
                        <TextBlock Text="圆直径" Grid.Row="1" Foreground="{DynamicResource Skin.Muted}"
                                   VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Slider x:Name="SldHighlight" Width="180" Minimum="16" Maximum="140"
                                    IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="LblHighlight" Width="52" Foreground="{DynamicResource Skin.Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="透明度" Grid.Row="2" Foreground="{DynamicResource Skin.Muted}"
                                   VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Slider x:Name="SldOpacity" Width="180" Minimum="10" Maximum="100"
                                    IsMoveToPointEnabled="True"/>
                            <TextBlock x:Name="LblOpacity" Width="52" Foreground="{DynamicResource Skin.Muted}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ChkMouse" Content="启用点击波纹(只在成片里出现,屏幕上看不到)"
                              Foreground="{DynamicResource Skin.Text}" Margin="0,8,0,0"
                              Checked="OnMouseEffectToggled" Unchecked="OnMouseEffectToggled"/>
                    <StackPanel x:Name="MouseDetail" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="左键颜色" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center"/>
                            <local:ColorPalette x:Name="PalLeftColor" Grid.Column="1"/>
                            <TextBlock Text="右键颜色" Grid.Row="1" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <local:ColorPalette x:Name="PalRightColor" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
                            <TextBlock Text="环半径" Grid.Row="2" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Slider x:Name="SldRadius" Width="180" Minimum="8" Maximum="120"
                                        IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="LblRadius" Width="52" Foreground="{DynamicResource Skin.Muted}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="持续时长" Grid.Row="3" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Slider x:Name="SldDuration" Width="180" Minimum="200" Maximum="1500"
                                        IsMoveToPointEnabled="True"/>
                                <TextBlock x:Name="LblDuration" Width="52" Foreground="{DynamicResource Skin.Muted}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 1:1 效果预览:内核只把圆点画进成片,屏幕上永远看不到,所以这里按当前参数模拟一次 -->
                        <Border x:Name="PreviewBox" Height="104" Margin="0,10,0,0" CornerRadius="8"
                                Background="{DynamicResource Skin.Card}" BorderBrush="{DynamicResource Skin.Border}"
                                BorderThickness="1" ClipToBounds="True" Cursor="Hand"
                                MouseLeftButtonDown="OnPreviewMouseDown"
                                MouseRightButtonDown="OnPreviewMouseDown"
                                MouseMove="OnPreviewMouseMove"
                                MouseLeave="OnPreviewMouseLeave">
                            <Grid ClipToBounds="True">
                                <Canvas x:Name="PreviewCanvas" Background="Transparent">
                                    <!-- 极淡的窗口轮廓,给个"桌面"的参照 -->
                                    <Rectangle Canvas.Left="16" Canvas.Top="14" Width="98" Height="62"
                                               RadiusX="4" RadiusY="4" Fill="{DynamicResource Skin.Bg}" Opacity="0.55"/>
                                    <Rectangle Canvas.Left="130" Canvas.Top="26" Width="122" Height="54"
                                               RadiusX="4" RadiusY="4" Fill="{DynamicResource Skin.Bg}" Opacity="0.32"/>
                                    <!-- 指针高亮:鼠标移进画布就跟着走,1:1 呈现成片里的实心圆 -->
                                    <Ellipse x:Name="PreviewHighlight" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <!-- 点击环:单击一圈,双击再加一圈 -->
                                    <Ellipse x:Name="PreviewClickOuter" Visibility="Collapsed" IsHitTestVisible="False" Fill="Transparent"/>
                                    <Ellipse x:Name="PreviewClickInner" Visibility="Collapsed" IsHitTestVisible="False" Fill="Transparent"/>
                                <Path x:Name="PreviewCursor" IsHitTestVisible="False"
                                      Fill="White" Stroke="#99000000" StrokeThickness="1"
                                      Data="M0,0 L0,15 L4.2,11.2 L6.8,17 L9.4,15.8 L6.8,10.2 L11.5,10.2 Z"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewHint" Text="点这块画布试一下(左键 / 右键各用各的颜色)· 按当前参数模拟,实际以成片为准"
                                   Foreground="{DynamicResource Skin.Muted}" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="快捷键" Foreground="{DynamicResource Skin.Accent}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="开始 / 停止" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbHotkeyRecord" Grid.Column="1" Width="120" HorizontalAlignment="Left"/>
                        <TextBlock Text="暂停 / 继续" Grid.Row="1" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox x:Name="CmbHotkeyPause" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <TextBlock Text="录制中截图" Grid.Row="2" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <ComboBox x:Name="CmbHotkeySnapshot" Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </Grid>
                    <TextBlock Text="全局生效,录制中也能用。只开放 F1~F12 —— 全局热键抢到字母键会让人在别处打不出字"
                               Foreground="{DynamicResource Skin.Muted}" FontSize="11"
                               Margin="110,6,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="输出" Foreground="{DynamicResource Skin.Accent}" FontSize="12.5"
                               FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="输出目录" Foreground="{DynamicResource Skin.Muted}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOutputDir" Grid.Column="1" Background="{DynamicResource Skin.Card}"
                                 Foreground="{DynamicResource Skin.Text}" BorderBrush="{DynamicResource Skin.Border}"
                                 BorderThickness="1" Padding="6,4" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnBrowse" Grid.Column="2" Style="{StaticResource GhostButton}"
                                Content="浏览" Margin="6,0,0,0" Click="OnBrowse"/>

                        <TextBlock Text="文件名模板" Grid.Row="1" Foreground="{DynamicResource Skin.Muted}"
                                   VerticalAlignment="Center" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <TextBox x:Name="TxtFileNameTpl" Background="{DynamicResource Skin.Card}"
                                     Foreground="{DynamicResource Skin.Text}" BorderBrush="{DynamicResource Skin.Border}"
                                     BorderThickness="1" Padding="6,4" VerticalContentAlignment="Center"/>
                            <TextBlock Text="占位符 {yyyyMMdd_HHmmss} 会替换为录制时间;留空恢复默认"
                                       Foreground="{DynamicResource Skin.Muted}" FontSize="11"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Margin="0,14,0,0">
                <TextBlock x:Name="LblVersion" Foreground="{DynamicResource Skin.Muted}" FontSize="11"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="取消" Click="OnClose"/>
                    <Button Style="{StaticResource GhostButton}" Content="保存" Margin="8,0,0,0"
                            Foreground="{DynamicResource Skin.Accent}" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
