<UserControl x:Class="ScreenRec.App.ColorPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="26">
    <Grid>
        <Button x:Name="Toggle" Width="180" Height="26" HorizontalAlignment="Left"
                HorizontalContentAlignment="Left" Padding="8,0" Click="OnToggleClick">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="Chip" Width="14" Height="14" CornerRadius="3" Margin="0,0,8,0"
                        BorderThickness="1" BorderBrush="#33000000" VerticalAlignment="Center"/>
                <TextBlock x:Name="Label" Text="蓝" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Button>

        <Popup x:Name="Pop" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Skin.Card}" BorderBrush="{DynamicResource Skin.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <WrapPanel x:Name="Swatches" Width="216"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
