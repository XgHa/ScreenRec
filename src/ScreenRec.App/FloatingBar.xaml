<Window x:Class="ScreenRec.App.FloatingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenRec" Width="212" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False">
    <Border Background="{DynamicResource Skin.Card}" CornerRadius="24"
            BorderBrush="{DynamicResource Skin.Border}" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <Ellipse x:Name="RecDot" Width="10" Height="10" Fill="{DynamicResource Skin.Rec}"
                     VerticalAlignment="Center">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.7" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock x:Name="TimeLabel" Text="00:00" Foreground="{DynamicResource Skin.Text}"
                       Margin="9,0,8,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            <Button x:Name="PauseButton" Style="{StaticResource GhostButton}" Width="30" Padding="0"
                    Click="OnPauseClick" ToolTip="暂停/继续(分段录制,停止时自动合并)">
                <TextBlock x:Name="PauseIcon" Text="&#xE769;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <Button x:Name="StopButton" Style="{StaticResource GhostButton}" Width="30" Padding="0"
                    Margin="4,0,0,0" Click="OnStopClick" ToolTip="停止并保存">
                <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="12"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
