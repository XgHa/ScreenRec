<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 皮肤系统 fallback 值:启动时 Skins.Publish 会用选中主题覆盖同名键。
         控件一律 DynamicResource 引用,切换皮肤全界面即时刷新。 -->
    <SolidColorBrush x:Key="Skin.Bg" Color="#F5FBF9"/>
    <SolidColorBrush x:Key="Skin.Card" Color="#E9F4F0"/>
    <SolidColorBrush x:Key="Skin.CardHover" Color="#DFF0EA"/>
    <SolidColorBrush x:Key="Skin.Border" Color="#C9D8D2"/>
    <SolidColorBrush x:Key="Skin.Text" Color="#1F3A33"/>
    <SolidColorBrush x:Key="Skin.Muted" Color="#7A9A91"/>
    <SolidColorBrush x:Key="Skin.Accent" Color="#2E9E85"/>
    <SolidColorBrush x:Key="Skin.OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Skin.Rec" Color="#C0392B"/>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Skin.Muted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Skin.CardHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Skin.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Skin.Muted}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Skin.CardHover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Skin.Text}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource Skin.Text}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Skin.Muted}"/>
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SkinContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Skin.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Skin.Border}"/>
        <Setter Property="Foreground" Value="{DynamicResource Skin.Text}"/>
    </Style>
</ResourceDictionary>
