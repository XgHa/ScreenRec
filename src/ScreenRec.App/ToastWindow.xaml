<Window x:Class="ScreenRec.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toast" Width="330" Height="78"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False">
    <Border Background="{DynamicResource Skin.Card}" CornerRadius="10"
            BorderBrush="{DynamicResource Skin.Border}" BorderThickness="1" Margin="2">
        <StackPanel Margin="14,10" Cursor="Hand" MouseLeftButtonDown="OnClick">
            <TextBlock x:Name="TitleLabel" Foreground="{DynamicResource Skin.Text}"
                       FontWeight="SemiBold" FontSize="13"/>
            <TextBlock x:Name="SubLabel" Foreground="{DynamicResource Skin.Muted}"
                       FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
