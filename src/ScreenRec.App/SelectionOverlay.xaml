<Window x:Class="ScreenRec.App.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制区域"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Cursor="Cross">
    <Window.Resources>
        <!-- 8 个调整手柄:白底蓝边小方块,Thumb 自带鼠标捕获,比手写拖拽可靠 -->
        <Style x:Key="HandleThumb" TargetType="Thumb">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="White" Stroke="#4C8DFF" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas x:Name="Root" Background="Transparent">
            <Rectangle x:Name="MaskTop" Fill="#99000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="MaskBottom" Fill="#99000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="MaskLeft" Fill="#99000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="MaskRight" Fill="#99000000" IsHitTestVisible="False"/>
            <Rectangle x:Name="SelBorder" Stroke="#4C8DFF" StrokeThickness="1.5"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
            <Border x:Name="SizeTag" Background="#E61E1F24" CornerRadius="4" Padding="8,3"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="#E8E9ED" FontSize="12"/>
            </Border>
        </Canvas>

        <Border x:Name="HintBox" Background="#CC1E1F24" CornerRadius="8" Padding="16,9"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0">
            <StackPanel>
                <TextBlock Text="拖拽鼠标选择录制区域" Foreground="#E8E9ED" FontSize="14"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Enter 确认 · Esc 取消 · 可重新拖拽"
                           Foreground="#9A9DA6" FontSize="12" Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
