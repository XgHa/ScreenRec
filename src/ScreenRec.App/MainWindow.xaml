<Window x:Class="ScreenRec.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenRec" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        MouseLeftButtonDown="OnDrag">
    <Border Background="{DynamicResource Skin.Bg}" CornerRadius="12"
            BorderBrush="{DynamicResource Skin.Border}" BorderThickness="1">
        <StackPanel Margin="14,12,14,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <RadioButton x:Name="TabFull" Content="全屏" Style="{StaticResource TabRadio}"
                                 IsChecked="True" GroupName="mode" Click="OnFullModeClick"/>
                    <RadioButton x:Name="TabRegion" Content="选区" Style="{StaticResource TabRadio}"
                                 GroupName="mode" Click="OnRegionModeClick" ToolTip="拖拽选择录制区域"/>
                    <RadioButton x:Name="TabWindow" Content="窗口" Style="{StaticResource TabRadio}"
                                 GroupName="mode" Click="OnWindowModeClick" ToolTip="选择要录制的窗口"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,-1,-6,0">
                    <Button x:Name="MinButton" Style="{StaticResource GhostButton}"
                            Width="26" Height="22" Padding="0"
                            Click="OnMinimizeClick" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton" Width="26" Height="22" Padding="0"
                            Margin="2,0,0,0" Click="OnCloseClick" ToolTip="关闭">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Skin.Rec}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Button x:Name="RecButton" Width="56" Height="56" Margin="0,16,0,14"
                    HorizontalAlignment="Center" Click="OnRecClick" Cursor="Hand"
                    ToolTip="开始录制">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ring" Stroke="{DynamicResource Skin.Rec}" StrokeThickness="3"/>
                            <Ellipse x:Name="dot" Fill="{DynamicResource Skin.Rec}" Width="26" Height="26"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Width" Value="30"/>
                                <Setter TargetName="dot" Property="Height" Value="30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 四个入口作为一组居中:原来参数居中、设置在右侧,整行重心偏右 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AudioButton" Style="{StaticResource GhostButton}"
                        Content="双轨收音" Click="OnAudioClick" ToolTip="选择音频来源"/>
                <Button x:Name="QualityButton" Style="{StaticResource GhostButton}"
                        Content="30fps · 高" Margin="6,0,0,0" Click="OnQualityClick" ToolTip="帧率与画质"/>
                <Border Width="1" Height="14" Margin="8,0" VerticalAlignment="Center"
                        Background="{DynamicResource Skin.Border}"/>
                <Button Style="{StaticResource GhostButton}" Content="设置" Click="OnSettingsClick"/>
                <Button Style="{StaticResource GhostButton}" Content="目录" Margin="2,0,0,0" Click="OnFolderClick"/>
            </StackPanel>

            <!-- 键位提示常驻:用户不会去翻设置才知道有快捷键,禁用的/被占用的键这里不显示 -->
            <TextBlock x:Name="HotkeyHint" Foreground="{DynamicResource Skin.Muted}" FontSize="10.5"
                       HorizontalAlignment="Center" Margin="0,9,0,-2"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </Border>
</Window>
